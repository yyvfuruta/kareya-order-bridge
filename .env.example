# Credenciais da Brendi (nunca commite este arquivo)
BRENDI_CLIENT_ID=
BRENDI_CLIENT_SECRET=
# BRENDI_BASE_URL=https://api.brendi.com.br

# Token que o Consumer envia. Gere com: openssl rand -hex 32
BRIDGE_TOKEN=

# Porta HTTP do bridge
PORT=8080

# Loja mostrada em GET /v1/stores (padrao: BRENDI_CLIENT_ID)
# BRIDGE_STORE_ID=
BRIDGE_STORE_NAME=Karê Ya Juvevê

# De-para de produtos Brendi -> codigo PDV do Consumer (opcional)
# BRIDGE_PRODUCT_MAP=products.json

# Confirma o evento na Brendi ao entregar os detalhes do pedido
BRIDGE_ACK_ON_DETAILS=true

# Reenvia QUALQUER evento como PLACED (so ligue se estiver perdendo pedido)
BRIDGE_POLL_ALL_EVENTS=false

# Loga headers de requisicoes sem token (use temporariamente p/ descobrir o formato)
BRIDGE_LOG_HEADERS=false
