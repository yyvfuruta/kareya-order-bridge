# Brendi credentials (never commit this file)
BRENDI_CLIENT_ID=
BRENDI_CLIENT_SECRET=
# BRENDI_BASE_URL=https://api.brendi.com.br

# Token sent by Consumer. Generate with: openssl rand -hex 32
BRIDGE_TOKEN=

# Bridge HTTP port
PORT=8080

# Listen interface. 127.0.0.1 = local machine only (local Consumer).
# Use 0.0.0.0 only if exposing it on the network/VPS.
BRIDGE_HOST=127.0.0.1

# Log file (append, no rotation). On Windows with NSSM, prefer NSSM stdout
# redirection and leave this line empty.
# BRIDGE_LOG_FILE=C:\kareya\bridge\bridge.log

# Store shown by GET /v1/stores (default: BRENDI_CLIENT_ID)
# BRIDGE_STORE_ID=
BRIDGE_STORE_NAME=Karê Ya Juvevê

# Brendi -> Consumer PDV product mapping (optional)
# BRIDGE_PRODUCT_MAP=products.json

# Acknowledge the Brendi event when delivering order details
BRIDGE_ACK_ON_DETAILS=true

# Forward ANY event as PLACED (enable only if missing orders)
BRIDGE_POLL_ALL_EVENTS=false

# Log headers of unauthenticated requests (temporarily, to discover the format)
BRIDGE_LOG_HEADERS=false
